# Copy this file to settings.env (same folder) and fill in values. Lines starting with # are ignored.
# Never share settings.env: it contains secrets.

# Moodle automatic sync (optional). Ask the Moodle administrator for a web-service token.
# MOODLE_URL=https://elearning.example.ac.rw
# MOODLE_TOKEN=paste-token-here

# Set to 1 only when the app is served over HTTPS.
# COOKIE_SECURE=0
